//This function counts the number of vowels in a given string.


function countVowels(str) {
    let vowelsCount = 0;
    const vowelsOnly = ['a', 'e', 'i', 'o', 'u'];
    for (let char of str) {
        if (vowelsOnly.includes(char)) {
            vowelsCount++;
        }
    }
    return vowelsCount;
};
module.exports = countVowels;
